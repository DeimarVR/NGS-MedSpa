# Copia este archivo como .env y llena los valores. NUNCA subas el .env.

# Postgres de Railway
DATABASE_URL=

# Sesión del panel (JWT_SECRET: mínimo 32 caracteres al azar)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Dirección pública del sitio, para los enlaces de los documentos
PUBLIC_WEB_URL=http://localhost:3000

# Datos de la clínica
CLINIC_NAME=NGS MedSpa
CLINIC_ADDRESS=
CLINIC_TIMEZONE=America/Chicago

# Bucket S3 de Railway (fotos y documentos)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Protege el cron diario de Vercel
CRON_SECRET=
